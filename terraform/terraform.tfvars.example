aws_region            = "us-east-1"
environment           = "dev"
project               = "stardrop"
cors_origins          = "http://localhost:3000,https://your-app.vercel.app"
github_connection_arn = "arn:aws:apprunner:us-east-1:ACCOUNT_ID:connection/CONNECTION_NAME/CONNECTION_ID"
github_repo_url       = "https://github.com/anomalyco/opencode"
github_branch         = "dev"
twitter_bearer_token        = "YOUR_TWITTER_BEARER_TOKEN"
twitter_access_token        = "YOUR_TWITTER_ACCESS_TOKEN"
twitter_access_token_secret = "YOUR_TWITTER_ACCESS_TOKEN_SECRET"
twitter_api_key             = "YOUR_TWITTER_API_KEY"
twitter_api_key_secret      = "YOUR_TWITTER_API_KEY_SECRET"
twitter_oauth2_client_id    = "YOUR_TWITTER_OAUTH2_CLIENT_ID"
twitter_oauth2_client_secret = "YOUR_TWITTER_OAUTH2_CLIENT_SECRET"
